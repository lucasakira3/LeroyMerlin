# SERVIDOR NEXT.JS — copie para .env.local; não preencha este modelo com chaves reais.
# Para a Vercel, cadastre as variáveis no painel, ambiente Production.

# Google Gemini — busca, visão e projeto guiado: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Anthropic Claude API — visão, chat e projeto guiado: https://console.anthropic.com/
ANTHROPIC_API_KEY=sua_chave_aqui

# Supabase do site: preserve estas variaveis na Vercel. A chave secreta e compartilhada com o backend mobile.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_chave_publica_aqui

# Atendimento mobile — quatro variáveis obrigatórias na Vercel.
# Os dois segredos são distintos, aleatórios e têm pelo menos 32 caracteres.
MOBILE_SESSION_SECRET=
MOBILE_ADMIN_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Desenvolvimento local apenas, quando não houver Supabase configurado.
# Não é necessário cadastrar esta variável na Vercel.
MOBILE_STORAGE=file
# Compatibilidade opcional com a chave JWT antiga; prefira SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: habilite segurança de push no Expo e configure o token no servidor.
EXPO_ACCESS_TOKEN=
# Preencher depois de gerar o APK: link HTTPS usado pela página /instalar.
MOBILE_ANDROID_URL=

# E-mail do "Esqueci minha senha" (lib/servidor/email.ts) — qualquer serviço SMTP.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=o endereço do Gmail e
# SMTP_PASS=uma "senha de app" (Conta Google > Segurança > Senhas de app; exige verificação
# em duas etapas). Sem estas variáveis o site funciona, só não envia o link de redefinição.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcional: quem aparece como remetente. Padrão: "Leroy Merlin (projeto FIAP)" <SMTP_USER>
EMAIL_REMETENTE=
