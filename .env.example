# Google Gemini API — embeddings (busca semântica): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# Anthropic Claude API — visão, chat e projeto guiado: https://console.anthropic.com/
ANTHROPIC_API_KEY=sua_chave_aqui

# Supabase (banco de dados) — painel do projeto > Connect, ou Project Settings > API Keys.
# Os mesmos três nomes vão nas variáveis de ambiente da Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública ("Publishable key", sb_publishable_...; "anon" nos projetos antigos)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua_chave_publica_aqui
# Chave secreta ("Secret key", sb_secret_...; "service_role" nos projetos antigos) — nunca commitar
SUPABASE_SECRET_KEY=sua_chave_secreta_aqui
